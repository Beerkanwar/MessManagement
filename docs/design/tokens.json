{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Hostel Mess Management Design Tokens",
  "version": "1.0.0",
  "colors": {
    "primary": "#0F766E",
    "primaryHover": "#115E59",
    "primarySubtle": "#F0FDFA",
    "primaryBorder": "#99F6E4",
    "text": "#0F172A",
    "textSecondary": "#475569",
    "textMuted": "#64748B",
    "bg": "#F8FAFC",
    "surface": "#FFFFFF",
    "border": "#E2E8F0",
    "borderStrong": "#CBD5E1",
    "success": "#15803D",
    "successSubtle": "#F0FDF4",
    "warning": "#B45309",
    "warningSubtle": "#FFFBEB",
    "danger": "#B91C1C",
    "dangerSubtle": "#FEF2F2",
    "info": "#1D4ED8",
    "infoSubtle": "#EFF6FF",
    "neutralState": "#475569"
  },
  "scannerResults": {
    "SUCCESS": {
      "bg": "#15803D",
      "text": "#FFFFFF",
      "label": "SUCCESS"
    },
    "DUPLICATE": {
      "bg": "#B45309",
      "text": "#FFFFFF",
      "label": "DUPLICATE"
    },
    "INVALID_CODE": {
      "bg": "#B91C1C",
      "text": "#FFFFFF",
      "label": "INVALID CODE"
    },
    "UNKNOWN_ROLL": {
      "bg": "#B91C1C",
      "text": "#FFFFFF",
      "label": "UNKNOWN ROLL"
    },
    "SUCCESS_PAUSE_NOTICE": {
      "bg": "#15803D",
      "text": "#FFFFFF",
      "label": "SUCCESS (PAUSE ENDS FROM THIS MEAL)"
    },
    "TIME_INVALID": {
      "bg": "#1E293B",
      "text": "#FFFFFF",
      "label": "TIME INVALID (SCANNING BLOCKED)"
    }
  },
  "statusMapping": {
    "syncTransaction": {
      "PENDING": "neutral",
      "SENDING": "info",
      "SYNCHRONIZED": "success",
      "CONFLICT": "warning",
      "REJECTED": "danger"
    },
    "managerAuthorization": {
      "ACTIVE": "success",
      "OFFLINE_NORMAL": "info",
      "OFFLINE_GRACE": "warning",
      "SYNC_REQUIRED": "danger",
      "REVOKE_PENDING_SYNC": "warning",
      "REVOKED": "danger"
    },
    "trustedTime": {
      "VALID": "success",
      "EXPIRING": "warning",
      "EXPIRED": "danger",
      "REQUIRES_SYNC": "danger",
      "INVALID_AFTER_REBOOT": "danger"
    },
    "pause": {
      "SCHEDULED": "info",
      "ACTIVE": "warning",
      "COMPLETED": "neutral",
      "CANCELLED": "neutral"
    },
    "billingPeriod": {
      "OPEN": "neutral",
      "BILL_GENERATED": "info",
      "REVIEWED": "warning",
      "LOCKED": "success"
    },
    "menu": {
      "DRAFT": "neutral",
      "PUBLISHED": "success"
    },
    "assignment": {
      "PENDING_VERIFICATION": "warning",
      "ACTIVE": "success",
      "ENDED": "neutral",
      "REJECTED": "danger"
    }
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontVariantNumeric": "tabular-nums",
    "styles": {
      "display": {
        "mobile": { "fontSize": 32, "lineHeight": 38 },
        "web": null,
        "fontWeight": 700
      },
      "h1": {
        "mobile": { "fontSize": 24, "lineHeight": 32 },
        "web": { "fontSize": 24, "lineHeight": 32 },
        "fontWeight": 600
      },
      "h2": {
        "mobile": { "fontSize": 20, "lineHeight": 28 },
        "web": { "fontSize": 20, "lineHeight": 28 },
        "fontWeight": 600
      },
      "h3": {
        "mobile": { "fontSize": 17, "lineHeight": 24 },
        "web": { "fontSize": 16, "lineHeight": 24 },
        "fontWeight": 600
      },
      "body": {
        "mobile": { "fontSize": 16, "lineHeight": 24 },
        "web": { "fontSize": 14, "lineHeight": 20 },
        "dense": { "fontSize": 13, "lineHeight": 18 },
        "fontWeight": 400
      },
      "label": {
        "mobile": { "fontSize": 14, "lineHeight": 20 },
        "web": { "fontSize": 13, "lineHeight": 18 },
        "fontWeight": 500
      },
      "caption": {
        "mobile": { "fontSize": 12, "lineHeight": 16 },
        "web": { "fontSize": 12, "lineHeight": 16 },
        "fontWeight": 400
      }
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "input": 6,
    "chip": 6,
    "card": 10,
    "sheet": 16,
    "dialog": 16,
    "pill": 9999
  },
  "elevation": {
    "web": {
      "border": "1px solid #E2E8F0",
      "menuShadow": "0 4px 12px rgba(15, 23, 42, 0.08)",
      "dialogShadow": "0 4px 12px rgba(15, 23, 42, 0.08)"
    },
    "mobile": {
      "0": 0,
      "1": 1,
      "2": 2,
      "3": 3
    }
  },
  "touchTargets": {
    "androidMin": 48,
    "iosMin": 44,
    "scannerMin": 56,
    "adjacentGapMin": 8
  },
  "motion": {
    "durationMs": 175,
    "easing": "cubic-bezier(0, 0, 0.2, 1)",
    "honorReducedMotion": true
  },
  "icons": {
    "set": "lucide",
    "size": 24,
    "strokeWidth": 1.75
  }
}

