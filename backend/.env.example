# ==============================================================================
# Environment Configuration Template for Backend
# Copy this file to .env and replace all placeholder values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_CRYPTOGRAPHICALLY_SECURE_KEY_MIN_50_CHARS
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 16 via psycopg 3)
DATABASE_URL=postgres://mess_dev:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/MessManagementDb

# CORS Origins (Web application origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration (SDD §100)
JWT_SIGNING_KEY=CHANGE_ME_JWT_SIGNING_SECRET_KEY_MIN_32_CHARS!
JWT_ISSUER=mess-management-auth
JWT_AUDIENCE=mess-management-api

# Email SMTP Settings (Mailpit in development, SMTP in production)
DEFAULT_FROM_EMAIL=noreply@hostel-mess.college.edu
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Secret Encryption (AES-GCM base64 32-byte key for student QR secrets)
SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY

# Logging
LOG_LEVEL=INFO
